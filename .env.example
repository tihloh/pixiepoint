APP_NAME=PixiePoint Wi-Fi
APP_URL=https://hs.portalx.win
APP_TIMEZONE=Asia/Manila
COOKIE_SECURE=true
SESSION_NAME=pixiepoint_session

# The hostname must resolve to the existing MariaDB container on the shared network.
DB_DSN=mysql:host=mariadb;port=3306;dbname=pixiepoint;charset=utf8mb4
DB_USER=pixiepoint
DB_PASS=replace-with-a-strong-database-password

ACCOUNTING_KEY=replace-with-at-least-32-random-bytes

